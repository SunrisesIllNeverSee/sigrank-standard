{
  "id": "11-content-independence",
  "description": "Content independence — the record must not contain prompt text, response text, source code, files, or credentials. Only token counts and optional source metadata.",
  "input": {
    "telemetry": { "input": 1000, "output": 5000, "cache_write": 500, "cache_read": 3000 },
    "source": { "provider": "test", "model": "test", "tool": "test" }
  },
  "expected": {
    "forbidden_fields": ["prompt", "response", "code", "file", "credential", "api_key", "content"],
    "required_fields": ["spec", "timestamp", "source", "telemetry", "metrics"]
  }
}
